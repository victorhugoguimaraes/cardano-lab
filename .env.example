# Blockfrost project IDs are network-specific. Never commit real keys.
BLOCKFROST_PREVIEW_API_KEY=
BLOCKFROST_PREPROD_API_KEY=

# Web lab keys are configured in the interface. These variables are optional
# and are kept only for local CLI usage.
BLOCKFROST_PREVIEW_PROJECT_ID=
BLOCKFROST_PREPROD_PROJECT_ID=

# Optional default values; the CLI asks for them when omitted.
CARDANO_NETWORK=preprod
ASSET_NAME=ORIGEM0001
POLICY_DURATION_DAYS=30
