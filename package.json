{
  "name": "cardano-lab",
  "version": "1.0.0",
  "description": "Laboratório Cardano + TypeScript na rede Preview",
  "main": "dist/index.js",
  "scripts": {
    "start": "bun run src/index.ts",
    "server": "bun run src/server.ts",
    "dev": "bun --watch src/index.ts",
    "dev:server": "bun --watch src/server.ts",
    "build": "tsc",
    "node:start": "node dist/index.js",
    "node:dev": "ts-node src/index.ts"
  },
  "keywords": [
    "cardano",
    "blockchain",
    "typescript",
    "blockfrost"
  ],
  "author": "Victor Hugo Guimarães",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorhugoguimaraes/cardano-lab.git"
  },
  "bugs": {
    "url": "https://github.com/victorhugoguimaraes/cardano-lab/issues"
  },
  "homepage": "https://github.com/victorhugoguimaraes/cardano-lab#readme",
  "dependencies": {
    "@blockfrost/blockfrost-js": "^5.5.0",
    "@emurgo/cardano-serialization-lib-nodejs": "^12.0.1",
    "bip39": "^3.1.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
